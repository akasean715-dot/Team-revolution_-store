rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && (
        request.auth.token.email == "akasean715@gmail.com" ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true
      );
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /orders/{orderId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if admin();
    }

    match /paymentIntents/{paymentIntentId} {
      allow read, write: if admin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string && request.resource.data.productId.size() > 0
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() >= 3 && request.resource.data.comment.size() <= 1000;
      allow update, delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /newsletter/{emailId} {
      allow create: if true;
      allow read, update, delete: if admin();
    }
  }
}
