PORT=3000

# Existing MEGA settings
MEGA_EMAIL=your-mega-email
MEGA_PASSWORD=your-mega-password

# Firebase
FIREBASE_PROJECT_ID=the-revolution-mma-store
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
# IMPORTANT: keep this JSON private. Generate a Firebase service-account key
# and paste the complete JSON on one line in production.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"the-revolution-mma-store","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@the-revolution-mma-store.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# Razorpay
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# Optional if the server is deployed separately
PUBLIC_BASE_URL=https://your-api-domain.example
