rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null && (
        request.auth.token.email == "akasean715@gmail.com" ||
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.admin == true
      );
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if admin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
